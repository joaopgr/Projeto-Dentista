# URL pública do app (obrigatório para links de confirmação no WhatsApp)
NEXT_PUBLIC_APP_URL=https://projeto-dentista-beige.vercel.app

# Supabase - obtenha em https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Chave service_role (Settings > API) — necessária para o portal do cliente
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Segredo para sessão do cliente (qualquer string longa e aleatória)
CLIENT_SESSION_SECRET=gere-uma-string-segura-aqui
